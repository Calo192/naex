+/** Hrany karty v ráme línie (pohľad hráča 0): karta hráča 1 je otočená o 180°. */
+function hranyVLinii(data: GameData, card: CardInstance, otocena: boolean): { left: readonly Slot[]; right: readonly Slot[] } {
+  const t = printedSides(data, card);
+  if (!otocena) return { left: t.left, right: t.right };
+  return { left: [...t.right].reverse(), right: [...t.left].reverse() };
+}
+
+/** Počet párov (dve neprázdne akcie na rovnakom indexe) na vnútornom spoji karty — so susedom bližšie k lokalite či s lokalitou. */
+export function paryVnutornehoSpoja(data: GameData, s: Pick<GameState, "strany">, strana: PlayerId, index: number): number {
+  const pl = s.strany[strana][index];
+  if (pl === undefined) return 0;
+  const moja = hranyVLinii(data, pl.card, pl.playedBy === 1);
+  const sused = s.strany[strana][index - 1];
+  // Štrngajú si len dve karty — spoj s lokalitou sa neráta.
+  if (sused === undefined) return 0;
+  const jeho = hranyVLinii(data, sused.card, sused.playedBy === 1);
+  const a = strana === 0 ? moja.right : moja.left;
+  const b = strana === 0 ? jeho.left : jeho.right;
+  let n = 0;
+  for (let i = 0; i < 4; i++) if (a[i] !== null && a[i] !== undefined && b[i] !== null && b[i] !== undefined) n++;
+  return n;
+}
+
+/** POKUS Štrng: karta vyložená lícom hore, ktorej vnútorný spoj má aspoň 3 páry, vráti hráčovi vypitý poldeci. */
+function strng(s: MutState, data: GameData, p: PlayerId, uid: number, events: Event[]): void {
+  if (s.strng !== true) return;
+  const kde = najdiVLinii(s, uid);
+  if (kde === null) return;
+  if (paryVnutornehoSpoja(data, s as GameState, kde.strana, kde.index) < 3) return;
+  const h = hrac(s, p);
+  if (s.strngy !== undefined) (s.strngy as [number, number])[p] += 1;
+  if (h.poldeciVypite <= 0) return;
+  h.poldeciVypite -= 1;
+  zmenPoldeci(s, p, "akcie", 1, events);
+  events.push({ type: "log", text: `Štrng! Trojitý spoj — hráčovi ${p + 1} sa dolieva poldeci.` });
+}
