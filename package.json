{
  "name": "naex",
  "private": true,
  "version": "0.1.0",
  "description": "NA EX! — kartová hra pre dvoch, v prehliadači, cez internet.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace=@naex/web",
    "dev:server": "npm run dev --workspace=@naex/server",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "start": "node --experimental-strip-types --env-file-if-exists=.env packages/server/src/index.ts",
    "kniznica": "npm run kniznica --workspace=@naex/server --",
    "hudba": "npm run hudba --workspace=@naex/server --",
    "melichar": "npm run melichar --workspace=@naex/server --"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
